# Copy to .env.local and fill in. Only VITE_* values reach the browser.
# Never put secret keys (service role, Stripe secret, Anthropic, VAPID private) in a VITE_ variable.

# Supabase (required). Use the project URL and the publishable (anon) key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# "true" opens the desktop without the sign-in screen (development only).
# "true" with no Supabase project: VITE_DEMO_MODE=true uses two blank test accounts instead.
VITE_DEMO_MODE=
VITE_SKIP_LOGIN=

# Development only: a test account that `npm run dev` signs in with automatically, so Discord and
# the other account-based apps work. The account must already exist in Supabase.
# Never put a real production password here, and never commit .env.local.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=

# Stripe publishable key, only used to show payment UI (optional).
VITE_PAYMENTS_CLIENT_TOKEN=


# ---- Server only (npm run dev:server / npm start). Never commit these. ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
PUBLIC_SITE_URL=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# Optional. Default: claude-haiku-5-5
LARP_JUDGE_MODEL=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
